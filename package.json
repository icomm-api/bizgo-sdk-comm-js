{
  "name": "@bizgo/bizgo-sdk-comm-js",
  "version": "1.2.0",
  "description": "TypeScript/JavaScript SDK for the Bizgo Communication API (SMS/LMS/MMS, RCS, Kakao AlimTalk/BrandMessage, Naver TalkTalk)",
  "license": "Apache-2.0",
  "author": "Infobank",
  "homepage": "https://github.com/icomm-api/bizgo-sdk-comm-js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/icomm-api/bizgo-sdk-comm-js.git"
  },
  "bugs": {
    "url": "https://github.com/icomm-api/bizgo-sdk-comm-js/issues"
  },
  "keywords": [
    "bizgo",
    "sms",
    "lms",
    "mms",
    "rcs",
    "kakao",
    "alimtalk",
    "messaging",
    "sdk"
  ],
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./webhooks": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "require": {
        "types": "./dist/testing.d.cts",
        "default": "./dist/testing.cjs"
      }
    },
    "./otel": {
      "import": {
        "types": "./dist/otel.d.ts",
        "default": "./dist/otel.js"
      },
      "require": {
        "types": "./dist/otel.d.cts",
        "default": "./dist/otel.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.3.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "generate": "node scripts/generate.mjs",
    "generate:check": "node scripts/generate.mjs --check",
    "smoke:pack": "node scripts/pack-smoke.mjs",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@opentelemetry/api": "1.9.1",
    "@types/node": "18.19.130",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "3.2.7",
    "yaml": "2.9.1"
  }
}
